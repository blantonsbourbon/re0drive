# Only used when creating a new data volume. Existing credentials can be changed in the UI.
RE0_GATEWAY_URL=https://re0.tgtodrive.top
RE0_GATEWAY_SECRET=
# For direct access from a NAS LAN, set 0.0.0.0; the default binds only localhost.
RE0DRIVE_HOST_BIND=127.0.0.1
TZ=Asia/Hong_Kong
# Set to 1 when the browser accesses the app over HTTPS through a reverse proxy.
RE0DRIVE_COOKIE_SECURE=0
