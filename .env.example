# Copy to .env and edit. Never commit .env.
# Image (multi-arch). Prefer a pinned tag on NAS, e.g. 0.1.0
RE0DRIVE_IMAGE=ghcr.io/blantonsbourbon/re0drive:latest
# For NAS LAN access set 0.0.0.0; default in repo compose is 127.0.0.1
RE0DRIVE_HOST_BIND=127.0.0.1
TZ=Asia/Hong_Kong
# Set to 1 when the browser reaches the app over HTTPS through a reverse proxy.
RE0DRIVE_COOKIE_SECURE=0
# Only used when creating a new data volume. Change later in the UI.
RE0_GATEWAY_URL=https://re0.tgtodrive.top
RE0_GATEWAY_SECRET=
# Optional test overrides (leave unset in production)
#RE0DRIVE_TG_BASE_URL=https://api.telegram.org
